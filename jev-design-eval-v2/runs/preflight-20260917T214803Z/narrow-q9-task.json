{
  "goal": "Prepare a local Civic Library reservation for Willow Room on October 14, 2026 at 2:00 PM for 60 minutes for Avery Chen using avery.chen@example.test.",
  "values": {
    "Floor": "Level 2",
    "Search rooms": "Willow",
    "Date": "2026-10-14",
    "Start time": "2:00 PM",
    "Length": "60 minutes",
    "Your name": "Avery Chen",
    "Email": "avery.chen@example.test",
    "I agree to the room rules": true
  },
  "steps": [
    {
      "name": "Find the room",
      "goal": "Filter the room list to Level 2 and Willow, then leave the matching room visible.",
      "assertions": [
        {
          "kind": "value_equals",
          "selector": "#floor-select",
          "expected": "Level 2"
        },
        {
          "kind": "value_equals",
          "selector": "#search-rooms",
          "expected": "Willow"
        },
        {
          "kind": "text_equals",
          "selector": "#filter-status",
          "expected": "Showing 1 room"
        },
        {
          "kind": "visible",
          "selector": "#room-card-willow",
          "expected": true
        }
      ],
      "checks": [
        {
          "id": "room-note-unclipped",
          "kind": "unclipped",
          "selector": "#room-note"
        },
        {
          "id": "room-title-ellipsis",
          "kind": "ellipsis",
          "selector": "#room-title"
        },
        {
          "id": "brand-artwork",
          "kind": "artwork",
          "selector": "#brand-motif"
        }
      ]
    },
    {
      "name": "Enter reservation details",
      "goal": "Open Willow Room and fill the date, time, length, name, email, and room rules.",
      "assertions": [
        {
          "kind": "visible",
          "selector": "#details-state",
          "expected": true
        },
        {
          "kind": "value_equals",
          "selector": "#reservation-date",
          "expected": "2026-10-14"
        },
        {
          "kind": "value_equals",
          "selector": "#start-time",
          "expected": "2:00 PM"
        },
        {
          "kind": "value_equals",
          "selector": "#length-select",
          "expected": "60 minutes"
        },
        {
          "kind": "value_equals",
          "selector": "#guest-name",
          "expected": "Avery Chen"
        },
        {
          "kind": "value_equals",
          "selector": "#guest-email",
          "expected": "avery.chen@example.test"
        },
        {
          "kind": "checked",
          "selector": "#rules-check",
          "expected": true
        }
      ],
      "checks": [
        {
          "id": "time-hint-contrast",
          "kind": "contrast",
          "selector": "#time-hint",
          "min_ratio": 4.5
        },
        {
          "id": "after-hours-disabled",
          "kind": "disabled",
          "selector": "#after-hours-button"
        },
        {
          "id": "review-aligned",
          "kind": "aligned",
          "selector": "#review-button",
          "other": "#details-title",
          "tolerance": 2
        },
        {
          "id": "review-unobstructed",
          "kind": "unobstructed",
          "selector": "#review-button"
        },
        {
          "id": "details-horizontal-fit",
          "kind": "horizontal_fit",
          "selector": "#details-state",
          "tolerance": 1
        }
      ]
    },
    {
      "name": "Open the review",
      "goal": "Open the local review summary for the prepared reservation.",
      "assertions": [
        {
          "kind": "visible",
          "selector": "#review-state",
          "expected": true
        },
        {
          "kind": "text_equals",
          "selector": "#review-room",
          "expected": "Willow Room"
        },
        {
          "kind": "text_equals",
          "selector": "#review-date",
          "expected": "October 14, 2026"
        },
        {
          "kind": "text_equals",
          "selector": "#review-time",
          "expected": "2:00 PM \u00b7 60 minutes"
        },
        {
          "kind": "text_equals",
          "selector": "#review-guest",
          "expected": "Avery Chen"
        },
        {
          "kind": "text_equals",
          "selector": "#review-email",
          "expected": "avery.chen@example.test"
        },
        {
          "kind": "text_equals",
          "selector": "#prepared-status",
          "expected": "Prepared for review \u00b7 no request sent."
        }
      ],
      "checks": [
        {
          "id": "header-badge-overlap",
          "kind": "decorative_overlap",
          "selector": "#availability-badge",
          "decorative": "#brand-motif",
          "content": ".brand-name"
        }
      ]
    }
  ],
  "url": "http://127.0.0.1:60306/holdout?build=q9",
  "viewport": {
    "width": 390,
    "height": 844
  },
  "max_steps": 60,
  "max_seconds": 180,
  "min_confidence": 0.8
}
